# Supabase Configuration
# Found in your Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (used ONLY in Supabase Edge Functions or backend scripts, NEVER prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Key
# IMPORTANT: For production, this should ONLY be configured in Supabase Edge Functions secrets (GEMINI_API_KEY).
# During local development/prototyping, VITE_GEMINI_API_KEY can be used as a client-side fallback.
VITE_GEMINI_API_KEY=your-gemini-api-key-here
